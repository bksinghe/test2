# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything here is read by config.Settings.from_env
# Only API_ID / API_HASH / BOT_TOKEN / ADMINS / LOG_CHANNEL / DATABASE_URL are
# mandatory; the bot refuses to start when one of them is missing.
# ---------------------------------------------------------------------------

# --- Telegram app credentials (https://my.telegram.org) --------------------
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
SESSION_NAME=auto_filter_bot
WORKERS=8

# --- people and channels ---------------------------------------------------
# comma separated telegram user ids
ADMINS=123456789
# channel where new users/groups/requests are logged (numeric id)
LOG_CHANNEL=-1001234567890
# support group id (0 to disable the shortcut)
SUPPORT_GROUP=0
# space separated channel ids/usernames that are auto indexed on startup
INDEX_CHANNELS=
# channel that stores the files so they can be streamed
BIN_CHANNEL=-1001234567890

# --- database --------------------------------------------------------------
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=Cluster0
COLLECTION_NAME=Files
USERS_COLLECTION=Users
CHATS_COLLECTION=Groups
META_COLLECTION=BotMeta
STREAM_COLLECTION=Streams

# --- public links ----------------------------------------------------------
# public base url of this container, required for streaming
URL=https://your-domain.example
SUPPORT_LINK=https://t.me/your_support
UPDATES_LINK=https://t.me/your_updates
FILMS_LINK=https://t.me/your_files
TUTORIAL=https://t.me/your_tutorial
VERIFY_TUTORIAL=https://t.me/your_verify_tutorial
OWNER_USERNAME=https://t.me/your_username

# --- payments (premium screen) --------------------------------------------
PAYMENT_QR=
OWNER_UPI_ID=sampleupi@upi

# --- behaviour -------------------------------------------------------------
TIMEZONE=Asia/Colombo
PORT=80
PICS=https://telegra.ph/file/58fef5cb458d5b29b0186.jpg https://telegra.ph/file/f0aa4f433132769f8970c.jpg
REACTIONS=🔥 👍 🎉 ⚡️ 🤩 😍 😎 🏆
MAX_BTN=10
CACHE_TIME=300
DELETE_TIME=3600
PM_FILE_DELETE_TIME=3600
VERIFY_EXPIRE=86400
STORAGE_LIMIT=536870912
SEND_ALL_LIMIT=50
LANGUAGES=Hindi English Tamil Telugu
QUALITY=360p 480p 720p 1080p

# --- default captions (per group overrides live in mongodb) ---------------
IMDB_TEMPLATE=
FILE_CAPTION=
WELCOME_TEXT=

# --- shortlink -------------------------------------------------------------
SHORTLINK_URL=
SHORTLINK_API=

# --- feature flags ---------------------------------------------------------
IS_PM_SEARCH=true
IS_VERIFY=true
AUTO_DELETE=false
WELCOME=true
PROTECT_CONTENT=false
LONG_IMDB_DESCRIPTION=false
LINK_MODE=true
AUTO_FILTER=true
IMDB=false
SPELL_CHECK=true
SHORTLINK=false
IS_STREAM=true
USE_CAPTION_FILTER=true

# --- streaming -------------------------------------------------------------
# optional HMAC secret for /watch and /download links (empty = unsigned links)
STREAM_SECRET=
